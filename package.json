{
  "name": "family-finance",
  "productName": "Family",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests",
    "test": "tsx --test tests/*.test.ts",
    "version:major": "node scripts/bump-version.mjs major",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:patch": "node scripts/bump-version.mjs patch",
    "release:major": "pnpm version:major && pnpm desktop:dist",
    "release:minor": "pnpm version:minor && pnpm desktop:dist",
    "release:patch": "pnpm version:patch && pnpm desktop:dist",
    "desktop:build": "cross-env FAMILY_DESKTOP_BUILD=1 next build",
    "desktop:run": "cross-env FAMILY_DESKTOP_BUILD=1 next build && electron .",
    "desktop:dist": "cross-env FAMILY_DESKTOP_BUILD=1 next build && electron-builder --win portable --x64",
    "postdesktop:dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-shortcut.ps1"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.57.0",
    "next": "^16.4.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "ru.family.finance",
    "productName": "Family",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next-family",
        "to": "site"
      },
      {
        "from": "build/family.ico",
        "to": "family.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/family.ico"
    },
    "portable": {
      "artifactName": "Family-${version}.exe"
    }
  },
  "description": "Совместные финансы Тимура и Беллы",
  "author": "Family"
}
